{
  "name": "Terraform Azure",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteEnv": {
    "AZURE_CONFIG_DIR": "${containerWorkspaceFolder}/.azure"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "ms-azuretools.vscode-azurecli"
      ],
      "settings": {
        "terraform.formatting.formatOnSave": true
      }
    }
  },
  "remoteUser": "vscode"
}